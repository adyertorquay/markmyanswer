# Required: your Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional: marking model and effort (defaults: claude-opus-5-5, medium)
# MARKING_MODEL=claude-opus-5-5
# MARKING_EFFORT=medium

# Required in production: Upstash Redis for rate limiting (free tier is enough).
# Without these, an in-memory limiter is used, which only suits local development.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: limits (defaults shown)
# LIMIT_PER_VISITOR_PER_DAY=20
# LIMIT_PER_VISITOR_PER_MINUTE=4
# LIMIT_GLOBAL_PER_DAY=1500
